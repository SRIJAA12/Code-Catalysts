generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String     @id
  email       String     @unique
  name        String?
  avatar      String?
  createdAt   DateTime   @default(now())
  firebaseUid String     @unique
  role        String     @default("user")
  updatedAt   DateTime
  Expense     Expense[]
  Note        Note[]
  PackItem    PackItem[]
  trips       Trip[]
}

model Trip {
  id          String     @id @default(cuid())
  title       String
  budget      Float?
  budgetStyle String?
  coverImage  String?
  createdAt   DateTime   @default(now())
  destination String?
  endDate     DateTime?
  interests   String[]   @default([])
  isPublic    Boolean    @default(false)
  shareSlug   String?    @unique
  startDate   DateTime?
  status      String     @default("draft")
  updatedAt   DateTime   @updatedAt
  userId      String
  Expense     Expense[]
  notes       Note[]
  PackItem    PackItem[]
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  TripCity    TripCity[]
}

model Activity {
  id          String   @id @default(cuid())
  cityId      String
  time        String?
  title       String
  description String?
  cost        Float?
  category    String?
  order       Int      @default(0)
  TripCity    TripCity @relation(fields: [cityId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(cuid())
  tripId    String?
  userId    String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trip      Trip?    @relation(fields: [tripId], references: [id])
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id
  tripId      String
  userId      String
  amount      Float
  category    String
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  Trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PackItem {
  id        String   @id
  tripId    String?
  userId    String
  label     String
  category  String?
  packed    Boolean  @default(false)
  createdAt DateTime @default(now())
  Trip      Trip?    @relation(fields: [tripId], references: [id])
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TripCity {
  id       String     @id
  tripId   String
  cityName String
  country  String?
  lat      Float?
  lng      Float?
  order    Int        @default(0)
  nights   Int?
  Activity Activity[]
  Trip     Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
}
